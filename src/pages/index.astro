---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import SiteHeader from '../components/SiteHeader.astro';

const posts = await Astro.glob('./posts/*.md');
posts.sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
---

<Layout title="Dave Beer" description="Occasional writing on technology, travel and whatever else takes my fancy.">
	<SiteHeader />
	<main>
		<p class="intro">Occasional writing on technology, travel and whatever else takes my fancy.</p>

		<p class="page-link"><a href="/fire-preparedness">Fire preparedness — Bushfire Places of Last Resort around Bendigo &rarr;</a></p>

		<div class="post-list">
			{ posts.filter(p => p.frontmatter.published !== false).map((post) => {
				return (
				<Card date={post.frontmatter.date} href={post.url ?? ''} title={post.frontmatter.title} body={post.frontmatter.description}></Card>
				)
			}) }
		</div>

	</main>
</Layout>

<style>
	main {
		margin: 0 auto;
		padding: 1.5rem 1.25rem 4rem;
		max-width: 42rem;
	}
	.intro {
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.6;
		margin: 0.75rem 0 1.25rem;
		max-width: 34rem;
	}
	.page-link {
		margin: 0 0 2.5rem;
	}
	.page-link a {
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.page-link a:hover {
		text-decoration: underline;
	}
	.post-list {
		display: flex;
		flex-direction: column;
	}
</style>
