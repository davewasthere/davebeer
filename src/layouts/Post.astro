---
const { frontmatter } = Astro.props;
import Layout from './Layout.astro';
import PostDate from '../components/PostDate.astro';
import SiteHeader from '../components/SiteHeader.astro';

const posts = Object.values(import.meta.glob('../pages/posts/*.md', { eager: true })).filter(p => p.frontmatter.published !== false);

posts.sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));

const currentIndex = posts.findIndex((post) => post.url === frontmatter.url);

const nextPost = posts[currentIndex - 1];
const prevPost = posts[currentIndex + 1];

---

<Layout title={frontmatter.title} description={frontmatter.description}>
	<SiteHeader compact />
	<main>
		<article>
			<header class="post-header">
				<h1>{frontmatter.title}</h1>
				{ frontmatter.date && <PostDate dateString={frontmatter.date} /> }
			</header>
			<div class="post-body">
				<slot />
			</div>
		</article>
	</main>
	<footer>
		<nav class="prevNext" aria-label="Adjacent posts">
			<div class="prevPost">{ prevPost && <a href={prevPost.url}><span class="dir">&larr; Older</span>{prevPost.frontmatter.title}</a>}</div>
			<div class="nextPost">{ nextPost && <a href={nextPost.url}><span class="dir">Newer &rarr;</span>{nextPost.frontmatter.title}</a>}</div>
		</nav>
	</footer>
</Layout>

<style is:global>
	main, footer {
		max-width: 42rem;
		margin: 0 auto;
		padding: 1rem 1.25rem;
	}
	.post-header {
		margin: 1.5rem 0 2rem;
	}
	.post-header h1 {
		font-size: 2rem;
		font-weight: 750;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin: 0 0 0.5rem;
	}
	.post-body {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.7;
	}
	.post-body h2, .post-body h3, .post-body h4 {
		font-family: var(--font-sans);
		letter-spacing: -0.01em;
		line-height: 1.3;
		margin: 2rem 0 0.75rem;
	}
	.post-body h2 { font-size: 1.4rem; }
	.post-body h3 { font-size: 1.15rem; }
	.post-body p {
		margin: 0 0 1.25rem;
	}
	.post-body a {
		color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}
	.post-body blockquote {
		margin: 1.5rem 0;
		padding: 0.25rem 0 0.25rem 1.25rem;
		border-left: 3px solid var(--accent);
		color: var(--muted);
	}
	.post-body img {
		border-radius: 6px;
	}
	.post-body pre {
		font-size: 0.85rem;
		line-height: 1.6;
		padding: 1rem 1.25rem;
		border-radius: 8px;
		overflow-x: auto;
	}
	.post-body :not(pre) > code {
		font-size: 0.85em;
		background-color: var(--surface);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.1em 0.35em;
	}
	.post-body table {
		border-collapse: collapse;
		margin: 1.5rem 0;
		font-family: var(--font-sans);
		font-size: 0.95rem;
	}
	.post-body th,
	.post-body td {
		padding: 0.5rem 1rem 0.5rem 0;
		border-bottom: 1px solid var(--border);
		text-align: left;
	}
	.post-body th {
		font-weight: 650;
		border-bottom-width: 2px;
	}
	.post-body hr {
		border: none;
		border-top: 1px solid var(--border);
		margin: 2.5rem 0;
	}
	footer {
		padding-top: 2rem;
		padding-bottom: 4rem;
	}
	.prevNext {
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		border-top: 1px solid var(--border);
		padding-top: 1.5rem;
	}
	.prevNext > div {
		width: 50%;
	}
	.prevNext a {
		display: block;
		text-decoration: none;
		color: inherit;
		font-weight: 600;
		font-size: 0.95rem;
		line-height: 1.4;
	}
	.prevNext a:hover {
		color: var(--accent);
	}
	.prevNext .dir {
		display: block;
		color: var(--muted);
		font-weight: 400;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.25rem;
	}
	.nextPost {
		text-align: right;
	}
</style>
