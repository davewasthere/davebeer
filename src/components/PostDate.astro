---
const { dateString } = Astro.props;
import { parseISO, format } from 'date-fns'
---
<time class="travel-date" datetime={dateString}>{ format(parseISO(dateString), 'dd LLL yyyy') }</time>

<style>
  .travel-date {
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
    padding: 0;
  }
</style>
