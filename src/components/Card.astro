---
export interface Props {
	title: string;
	body: string;
	href: string;
	date: string;
}

import PostDate from './PostDate.astro';

const { href, title, body, date } = Astro.props;
---

<article class="entry">
	<a href={href}>
		<PostDate dateString={date}></PostDate>
		<h2>{title}</h2>
		{ body && <p>{body}</p> }
	</a>
</article>

<style>
	.entry {
		border-top: 1px solid var(--border);
	}
	.entry:last-child {
		border-bottom: 1px solid var(--border);
	}

	.entry > a {
		display: block;
		padding: 1.15rem 0;
		text-decoration: none;
		color: inherit;
	}

	.entry h2 {
		margin: 0.2rem 0 0;
		font-size: 1.15rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}

	.entry a:hover h2 {
		color: var(--accent);
	}

	p {
		margin: 0.35rem 0 0;
		color: var(--muted);
		line-height: 1.55;
	}
</style>
